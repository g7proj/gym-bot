# Local secrets template (managed automatically in .env.local by scripts/dev-start.ps1)
# Generate a 32-byte base64 key with PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Shared secret for authenticating scheduled triggers to gym-auto-book
CRON_SECRET=replace_with_random_secret

# Optional: override the default InfoYou portal AppToken if rotated by the provider
# GYM_APP_TOKEN=

# Optional: Telegram Bot configuration for auto-book error notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
