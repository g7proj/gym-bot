# Python booking job configuration (copy to .env for local runs)
# Generate a 32-byte base64 key with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace_with_32_byte_base64_key

# Postgres connection string (local Docker or Supabase pooled/direct URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: override the default InfoYou portal AppToken if rotated by the provider
# GYM_APP_TOKEN=
